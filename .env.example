# Bu dosyayı ".env" adıyla kopyala ve istediğin satırları doldur. Hepsi isteğe bağlı.

# Kendi TMDB anahtarın (https://www.themoviedb.org/settings/api). Boş bırakılırsa projedeki anahtar kullanılır.
TMDB_API_KEY=
# veya v4 "API Read Access Token" (anahtar yerine bunu kullanır)
TMDB_READ_TOKEN=

# Ana TMDB isteği geçici olarak çalışmazsa, aynı TMDB biçiminde JSON dönen yetkili Worker adresi.
# Bu değer yalnızca Worker secret olarak tutulur; tarayıcıya gönderilmez.
TMDB_FALLBACK_URL=

# DNS engeli DoH ile de aşılamazsa: kendi Cloudflare Worker adresin (scripts/cloudflare-worker.js)
TMDB_PROXY_URL=
TMDB_IMAGE_PROXY_URL=
# Vekil adresi ?endpoint=/discover/tv biçiminde çalışıyorsa: query
TMDB_PROXY_STYLE=path

# "Nerede izlenir" bölgesi
WATCH_REGION=TR

# Video dosyalarının klasörü (varsayılan: proje içindeki media/)
MEDIA_DIR=

PORT=3000

# Cloudflare Worker'da kendi yetkili medya kaynakların için seçenekler:
# MEDIA_SOURCES KV anahtarı örneği: tv:127532:1:1
# Değer örneği: {"sources":[{"name":"Cloudflare Stream","type":"hls","url":"https://videodelivery.net/<id>/manifest/video.m3u8","subtitles":[{"lang":"tr","label":"Türkçe","url":"https://media.ornegin.com/subs/bolum-1.vtt"}]}]}
# Küçük kataloglarda bunun yerine Worker secret olarak MEDIA_SOURCES_JSON kullanılabilir.
# Büyük kataloglarda Worker secret MEDIA_SOURCE_API ve MEDIA_SOURCE_TOKEN ile kendi yetkili medya API'ne bağlanabilir.

