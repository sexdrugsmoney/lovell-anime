# Anthology Scraper — ortam değişkenleri
# Bu dosyayı ".env" olarak kopyala ve değerleri doldur.

# ZORUNLU: TMDB API anahtarı (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# ZORUNLU: AnimeciX x-e-h header token (AnimeciX endpoint'i çalışması için gerekli)
ANIMECIX_TOKEN=

# Opsiyonel: sunucunun dinleyeceği port (varsayılan: 3000)
PORT=3777
